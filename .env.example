# Grocery Optimizer - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Database Connection URL (PostgreSQL)
# For local system PostgreSQL:
DATABASE_URL=postgresql+psycopg://howlcipher:grocery_dev@localhost:5432/grocery_optimizer
# For Docker Compose:
# DATABASE_URL=postgresql+psycopg://grocery_user:grocery_pass@localhost:5432/grocery_optimizer

# CORS Allowed Origins (Comma-separated list or JSON array string)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Application Environment (development, testing, production)
ENVIRONMENT=development
